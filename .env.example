# Copie para .env (que NÃO é versionado). Todos os valores abaixo são fictícios, só para desenvolvimento.
POSTGRES_USER=gamelist
POSTGRES_PASSWORD=gamelist
POSTGRES_DB=gamelist

# Usuário inicial da aplicação (criado/atualizado quando a API inicia)
GAMESLIST_ADMIN_USER=admin
GAMESLIST_ADMIN_PASSWORD=admin123

# URL da API e token opcional consumidos pela CLI.
GAMESLIST_API_URL=http://api:8080
# Token do login (POST /api/web/login), usado pelos comandos autenticados da CLI (add/edit). Deixe vazio no repositório.
GAMESLIST_TOKEN=


# Popula o banco com jogos de exemplo na primeira execução (true/false). Não duplica se já houver dados.
GAMESLIST_SEED=false
